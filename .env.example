# ------------------------------------------------------------------
# WebSentinel configuration — copy to .env and adjust as needed.
#
# Local runs default to a SQLite database (instance/websentinel.db) and
# listen on port 8080, so nothing below is required to start.
# docker-compose overrides WEBSENTINEL_DB_URI with PostgreSQL internally.
# ------------------------------------------------------------------

# Target site being protected. Defaults to http://127.0.0.1:9000 for local
# runs and http://host.docker.internal:9000 inside Docker Compose (so the
# container can reach a service on your host machine). Uncomment to override.
# WEBSENTINEL_TARGET=http://127.0.0.1:9000
WEBSENTINEL_PORT=8080

# Dashboard authentication (single-admin-user)
# WEBSENTINEL_ADMIN_PASS is REQUIRED — the app refuses to start without it.
WEBSENTINEL_ADMIN_USER=admin
WEBSENTINEL_ADMIN_PASS=changeme
WEBSENTINEL_SECRET_KEY=changeme-generate-a-random-secret

# Email alerting for Critical/High incidents via the Gmail API (OAuth).
# No SMTP, no app passwords — you only need:
#   1. credentials.json  (OAuth client, "Desktop app" type, from Google Cloud)
#   2. a one-time login  (run `python -m utils.alerting authorize`)
# See README "Email alerting" for the full setup. Settings page overrides env.
WEBSENTINEL_ALERT_ENABLED=false
WEBSENTINEL_ALERT_EMAIL=you@gmail.com
WEBSENTINEL_ALERT_COOLDOWN_MINUTES=60
# Optional: paths to the Google OAuth files (needed when mounting them in Docker).
# WEBSENTINEL_GOOGLE_CREDENTIALS=credentials.json
# WEBSENTINEL_GOOGLE_TOKEN=token.json
# Optional: base URL used for the dashboard link inside alert emails.
# WEBSENTINEL_PUBLIC_URL=http://localhost:8080

# Request hardening
WEBSENTINEL_MAX_BODY_SIZE=1048576          # reject bodies larger than this (413)
WEBSENTINEL_RATE_LIMIT=100                 # requests per window per client IP (0 disables)
WEBSENTINEL_RATE_LIMIT_WINDOW=60           # window in seconds
# Rate limiting uses the raw socket peer (request.remote_addr). If you run
# behind a single trusted reverse proxy (Nginx, Traefik, Cloudflare, ...),
# set this to true so the real client IP is read from the right-most
# X-Forwarded-For entry (the one the trusted proxy itself appends).
# WEBSENTINEL_TRUST_PROXY=false

# Brute force detector config
WEBSENTINEL_BRUTE_FORCE_STATUS_CODES=401,403
WEBSENTINEL_BRUTE_FORCE_LOGIN_PATHS=login,signin,auth,admin

# Data retention (days — rows older than this are cleaned up on startup)
WEBSENTINEL_RETENTION_REQUESTS_DAYS=30
WEBSENTINEL_RETENTION_INCIDENTS_DAYS=90

# IP auto-blocklist (blocks repeat attackers automatically)
WEBSENTINEL_AUTOBLOCK_ENABLED=true
WEBSENTINEL_AUTOBLOCK_THRESHOLD=5
WEBSENTINEL_AUTOBLOCK_WINDOW_MINUTES=10
WEBSENTINEL_AUTOBLOCK_DURATION_MINUTES=1440
